{
  "name": "drama-studio-companion",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "description": "Drama Studio Companion: the browser extension that works alongside the Drama Studio desktop app.",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:tooling": "node --test tests/tooling/*.node.mjs",
    "scan:source": "node scripts/scan-source.mjs",
    "scan:output": "node scripts/scan-output.mjs",
    "verify:build": "node scripts/verify-production-build.mjs",
    "verify:zip": "node scripts/verify-release-zip.mjs",
    "smoke:browser": "node scripts/smoke-extension.mjs",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run test:tooling && npm run scan:source",
    "verify": "npm run check && npm run build && npm run verify:build && npm run scan:output",
    "ci": "npm run verify && npm run zip && npm run verify:zip",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@tabler/icons-vue": "3.46.0",
    "@wxt-dev/storage": "1.2.9",
    "vue": "3.5.24",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.2.5",
    "@wxt-dev/module-vue": "1.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "happy-dom": "20.11.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9",
    "wxt": "0.21.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
