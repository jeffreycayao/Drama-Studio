{
  "name": "@faceless-automations/platform-contracts",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Strict runtime contracts shared by Paks Tools Faceless automations extensions and the central platform API.",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify:build"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
