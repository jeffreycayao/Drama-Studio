{
  "name": "@faceless-automations/platform-api",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "description": "Vercel Node.js API for Paks Tools Faceless automations authentication, commerce, entitlements, and administration.",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run build && node scripts/dev-server.mjs",
    "format": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "scan:source": "node scripts/security-scan.mjs",
    "build": "tsc -p tsconfig.build.json",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run scan:source",
    "ci": "npm run check && npm run build && npm run verify:build"
  },
  "dependencies": {
    "@faceless-automations/platform-contracts": "0.1.2",
    "@neondatabase/serverless": "1.1.0",
    "@vercel/blob": "2.8.0",
    "jose": "6.2.9",
    "stripe": "22.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
