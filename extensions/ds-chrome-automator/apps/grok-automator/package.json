{
  "name": "grok-automator",
  "version": "0.0.13",
  "private": true,
  "type": "module",
  "description": "Maintainable WXT/Vue Grok Automator™ extension for the Paks Tools Faceless automations monorepo.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --check .",
    "test": "vitest run",
    "test:tooling": "node --test tests/tooling/*.node.mjs",
    "generate:version-badge": "node scripts/generate-version-badge.mjs",
    "check:version-badge": "node scripts/check-version-badge.mjs",
    "smoke:browser": "node scripts/smoke-extension.mjs",
    "verify:boundaries": "node scripts/verify-source-boundaries.mjs",
    "scan:source": "node scripts/scan-source.mjs",
    "scan:output": "node scripts/scan-output.mjs",
    "verify:build": "node scripts/verify-production-build.mjs",
    "verify:zip": "node scripts/verify-release-zip.mjs",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run test:tooling && npm run check:version-badge && npm run verify:boundaries && npm run scan:source",
    "verify": "npm run check && npm run build && npm run verify:build && npm run scan:output",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@faceless-automations/brand": "0.1.0",
    "@faceless-automations/platform-contracts": "0.1.2",
    "@tabler/icons-vue": "3.46.0",
    "@wxt-dev/storage": "1.2.9",
    "vue": "3.5.24",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.2.5",
    "@wxt-dev/module-vue": "1.0.3",
    "badge-maker": "6.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "terser": "5.50.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9",
    "wxt": "0.21.4"
  }
}
