# Public Paks Tools Faceless automations service origins. Production builds
# use the deployed Vercel URLs when these values are empty. These are locations, not
# credentials; secrets remain Vercel-only and must never use a WXT_ variable.
WXT_PLATFORM_API_ORIGIN=https://paks-api.vercel.app
WXT_PLATFORM_WEB_ORIGIN=https://paks-tools.vercel.app

# For `npm run dev:grok`, either value may instead be an exact loopback or
# private-LAN HTTP origin, for example http://127.0.0.1:8787 or
# http://10.56.55.108:8787. Production builds reject insecure origins.
