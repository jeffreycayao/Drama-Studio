{
  "name": "faceless-automation-dashboard",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "description": "TypeScript storefront, authentication and protected administration surface for Paks Tools Faceless automations.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "verify:build": "node scripts/verify-build.mjs",
    "preview": "vite preview",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test",
    "ci": "npm run check && npm run build && npm run verify:build"
  },
  "dependencies": {
    "@faceless-automations/brand": "0.1.0",
    "@faceless-automations/platform-contracts": "0.1.2",
    "@tabler/icons-react": "3.46.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "happy-dom": "20.11.2",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "terser": "5.50.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
