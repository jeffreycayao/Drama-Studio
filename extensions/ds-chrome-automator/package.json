{
  "name": "chris.dev-faceless-automations-monorepo",
  "version": "0.3.5",
  "private": true,
  "description": "Private monorepo for the Paks Tools Faceless automations application collection.",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:grok",
    "dev:api": "npm run dev --workspace=apps/faceless-platform-api",
    "dev:api:lan": "npm run dev --workspace=apps/faceless-platform-api -- --host 0.0.0.0",
    "dev:dashboard": "npm run dev --workspace=apps/faceless-automation-dashboard",
    "dev:dashboard:lan": "npm run dev --workspace=apps/faceless-automation-dashboard -- --host 0.0.0.0",
    "dev:grok": "npm run dev --workspace=apps/grok-automator",
    "dev:grok:lan": "npm run dev --workspace=apps/grok-automator -- --host 0.0.0.0",
    "format": "prettier --write .",
    "format:api": "npm run format --workspace=apps/faceless-platform-api",
    "format:dashboard": "npm run format --workspace=apps/faceless-automation-dashboard",
    "format:grok": "npm run format --workspace=apps/grok-automator",
    "format:check": "prettier --check .",
    "format:check:api": "npm run format:check --workspace=apps/faceless-platform-api",
    "format:check:dashboard": "npm run format:check --workspace=apps/faceless-automation-dashboard",
    "format:check:grok": "npm run format:check --workspace=apps/grok-automator",
    "typecheck": "npm run typecheck:contracts && npm run typecheck:api && npm run typecheck:dashboard && npm run typecheck:grok",
    "typecheck:api": "npm run typecheck --workspace=apps/faceless-platform-api",
    "typecheck:contracts": "npm run typecheck --workspace=packages/platform-contracts",
    "typecheck:dashboard": "npm run typecheck --workspace=apps/faceless-automation-dashboard",
    "typecheck:grok": "npm run typecheck --workspace=apps/grok-automator",
    "lint": "npm run lint:api && npm run lint:dashboard && npm run lint:grok",
    "lint:api": "npm run lint --workspace=apps/faceless-platform-api",
    "lint:dashboard": "npm run lint --workspace=apps/faceless-automation-dashboard",
    "lint:grok": "npm run lint --workspace=apps/grok-automator",
    "test": "npm run test:brand && npm run test:contracts && npm run test:api && npm run test:dashboard && npm run test:grok",
    "test:api": "npm test --workspace=apps/faceless-platform-api",
    "test:brand": "npm test --workspace=packages/brand",
    "test:contracts": "npm test --workspace=packages/platform-contracts",
    "test:dashboard": "npm test --workspace=apps/faceless-automation-dashboard",
    "test:grok": "npm test --workspace=apps/grok-automator",
    "test:tooling:grok": "npm run test:tooling --workspace=apps/grok-automator",
    "test:vercel-tooling": "node --test scripts/vercel-release.test.mjs",
    "verify:vercel-config": "node scripts/verify-vercel-config.mjs",
    "release:vercel": "node scripts/vercel-release.mjs",
    "verify:boundaries:grok": "npm run verify:boundaries --workspace=apps/grok-automator",
    "scan:source:grok": "npm run scan:source --workspace=apps/grok-automator",
    "scan:source:api": "npm run scan:source --workspace=apps/faceless-platform-api",
    "check": "npm run format:check && npm run check:brand && npm run check:contracts && npm run check:api && npm run check:dashboard && npm run check:grok",
    "check:api": "npm run check --workspace=apps/faceless-platform-api",
    "check:brand": "npm run check --workspace=packages/brand",
    "check:contracts": "npm run check --workspace=packages/platform-contracts",
    "check:dashboard": "npm run check --workspace=apps/faceless-automation-dashboard",
    "check:grok": "npm run check --workspace=apps/grok-automator",
    "build": "npm run build:contracts && npm run build:api && npm run build:dashboard && npm run build:grok",
    "build:api": "npm run build --workspace=apps/faceless-platform-api",
    "build:contracts": "npm run build --workspace=packages/platform-contracts",
    "build:dashboard": "npm run build --workspace=apps/faceless-automation-dashboard",
    "build:grok": "npm run build --workspace=apps/grok-automator",
    "verify:build": "npm run verify:build:contracts && npm run verify:build:api && npm run verify:build:dashboard && npm run verify:build:grok",
    "verify:build:api": "npm run verify:build --workspace=apps/faceless-platform-api",
    "verify:build:contracts": "npm run verify:build --workspace=packages/platform-contracts",
    "verify:build:dashboard": "npm run verify:build --workspace=apps/faceless-automation-dashboard",
    "verify:build:grok": "npm run verify:build --workspace=apps/grok-automator",
    "scan:output:grok": "npm run scan:output --workspace=apps/grok-automator",
    "verify": "npm run check && npm run build && npm run verify:build && npm run scan:output:grok",
    "verify:grok": "npm run verify --workspace=apps/grok-automator",
    "zip": "npm run zip:grok",
    "zip:grok": "npm run zip --workspace=apps/grok-automator",
    "verify:zip": "npm run verify:zip:grok",
    "verify:zip:grok": "npm run verify:zip --workspace=apps/grok-automator",
    "smoke:grok": "npm run smoke:browser --workspace=apps/grok-automator --",
    "audit": "npm audit --audit-level=low --workspaces --include-workspace-root",
    "ci": "npm run verify:vercel-config && npm run test:vercel-tooling && npm run verify && npm run zip:grok && npm run verify:zip:grok && npm run audit",
    "ci:grok": "npm run check:grok && npm run build:grok && npm run verify:build:grok && npm run scan:output:grok && npm run zip:grok && npm run verify:zip:grok"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.9.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
