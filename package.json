    "html2canvas": "^1.4.1",
    "icon-gen": "^5.0.0",
    "jsonata": "^2.1.0",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.294.0",
    "mp4box": "^2.4.1",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0",
    "zustand": "^4.4.7"
  },
  "build": {
    "appId": "com.comfystudio.app",
    "productName": "Drama Studio",
    "copyright": "Copyright © 2024-2026",
    "beforePack": "scripts/electron-builder-before-pack.cjs",
    "afterPack": "scripts/electron-builder-after-pack.cjs",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/utils/audioVolumeEnvelope.mjs",
      "src/utils/audioEq.mjs",
      "src/utils/audioAnalysisDsp.mjs",
      "build/icon.png",
      "package.json",
      "!dist/**/*.map",
      "!dist/ComfyStudio_Project_Selection_Screen_BG.png",
      "!dist/kling_o3_i2v_00002_.mp4",
      "!dist/test_video.mp4",
      "!dist/welcome-hero.mp4",
      "!dist/hero-v1.webp",
      "!dist/splash.jpg",
      "!dist/splash.png",
      "!**/*.map",
      "!**/*.zip",
      "!**/*.safetensors",
      "!**/Drama Studio SFX/**",
      "!node_modules/ffmpeg-static/ffmpeg*",
      "!node_modules/@derhuerst/ffprobe-static/ffprobe*"
    ],
    "extraResources": [
      {
        "from": "public/workflows",
        "to": "workflows",
        "filter": [
          "**/*",
          "!setup-covers/**"
        ]
      },
      {
        "from": "node_modules/ffmpeg-static",
        "to": "bin",
        "filter": [
          "ffmpeg.exe",
          "ffmpeg",
          "ffmpeg.README",
          "ffmpeg.LICENSE",
          "ffmpeg.exe.README",
          "ffmpeg.exe.LICENSE"
        ]
      },
      {
        "from": "node_modules/@derhuerst/ffprobe-static",
        "to": "bin",
        "filter": [
          "ffprobe.exe",
          "ffprobe",
          "ffprobe.README",
          "ffprobe.LICENSE",
          "ffprobe.exe.README",
          "ffprobe.exe.LICENSE"
        ]
      },
      {
        "from": "build/rife-runtime/${os}-${arch}/rife",
        "to": "bin/rife",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts/rtx_vsr_stream.py",
        "to": "scripts/rtx_vsr_stream.py"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Drama-Studio-${version}-windows-${arch}.${ext}",
      "azureSignOptions": {
        "publisherName": "Jeffrey Cayao",
        "endpoint": "https://eus.codesigning.azure.net",
        "codeSigningAccountName": "velorn-signing",
        "certificateProfileName": "velorn-public"
      }
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "artifactName": "Drama-Studio-${version}-mac-${arch}.${ext}",
      "notarize": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Video",
      "maintainer": "Drama Studio contributors <hi@jepoy.dev>",
      "artifactName": "Drama-Studio-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Drama-Studio-${version}-windows-installer-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Drama-Studio-${version}-windows-portable-${arch}.${ext}"
    },
    "appx": {
      "artifactName": "Drama-Studio-${version}-windows-store-${arch}.${ext}",
      "identityName": "JEPOY.DramaStudio",
      "publisher": "CN=632EB17B-0D03-4FA7-94B1-DE17D969AC6C",
      "publisherDisplayName": "JEPOY",
      "displayName": "Drama Studio",
      "applicationId": "DramaStudio",
      "backgroundColor": "#27221B",
      "languages": [
        "en-US"
      ],
      "capabilities": [
        "runFullTrust",
        "unvirtualizedResources"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "customManifestPath": "appxmanifest.xml"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
